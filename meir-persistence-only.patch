diff --git a/talkback/src/main/java/com/google/android/accessibility/talkback/MeirServiceGuard.java b/talkback/src/main/java/com/google/android/accessibility/talkback/MeirServiceGuard.java
new file mode 100644
index 0000000..d81e787
--- /dev/null
+++ b/talkback/src/main/java/com/google/android/accessibility/talkback/MeirServiceGuard.java
@@ -0,0 +1,61 @@
+/* Copyright 2026. Licensed under the Apache License, Version 2.0.
+ * Experimental persistence mitigation. Not a guarantee against OEM force-stop. */
+package com.google.android.accessibility.talkback;
+
+import android.app.Notification;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.app.PendingIntent;
+import android.app.Service;
+import android.content.Intent;
+import android.content.pm.ServiceInfo;
+import android.os.Build;
+import android.util.Log;
+
+/** Keeps only the user-enabled reader in the foreground; never enables or restarts it. */
+final class MeirServiceGuard {
+  private static final String CHANNEL = "meir_reader_guard";
+  private static final int ID = 0x4d454952;
+  private MeirServiceGuard() {}
+
+  static void start(Service service) {
+    try {
+      NotificationManager manager = service.getSystemService(NotificationManager.class);
+      NotificationChannel channel = new NotificationChannel(
+          CHANNEL, "SandFly test running", NotificationManager.IMPORTANCE_LOW);
+      channel.setSound(null, null);
+      channel.enableVibration(false);
+      manager.createNotificationChannel(channel);
+      Intent settings = new Intent(service,
+          com.google.android.accessibility.talkback.preference.TalkBackPreferencesActivity.class);
+      PendingIntent pending = PendingIntent.getActivity(service, ID, settings,
+          PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE);
+      Notification note = new Notification.Builder(service, CHANNEL)
+          .setSmallIcon(R.drawable.icon)
+          .setContentTitle(service.getString(R.string.meir_guard_title))
+          .setContentText(service.getString(R.string.meir_guard_text))
+          .setContentIntent(pending)
+          .setOngoing(true)
+          .setOnlyAlertOnce(true)
+          .setCategory(Notification.CATEGORY_SERVICE)
+          .build();
+      if (Build.VERSION.SDK_INT >= 34) {
+        service.startForeground(ID, note, ServiceInfo.FOREGROUND_SERVICE_TYPE_SPECIAL_USE);
+      } else {
+        service.startForeground(ID, note);
+      }
+      Log.i("MeirGuard", "Foreground protection active; no force-stop guarantee");
+    } catch (RuntimeException error) {
+      // Foreground-start restrictions must never crash or disable the reader.
+      Log.w("MeirGuard", "Foreground protection unavailable; reader remains active", error);
+    }
+  }
+
+  static void stop(Service service) {
+    try {
+      service.stopForeground(Service.STOP_FOREGROUND_REMOVE);
+    } catch (RuntimeException error) {
+      Log.w("MeirGuard", "Could not remove foreground notification", error);
+    }
+  }
+}
